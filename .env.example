APP_NAME=Admin
APP_ENV=local
PORT=8001

# Optional: Google OAuth settings for the admin login step later.
# GCP Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
SESSION_SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_SECURE=false

# Share data with the sibling datahub app.
DATAHUB_DATABASE_FILE=/datahub/datahub.db
DATAHUB_UPLOAD_DIR=/datahub/uploads

# Optional allowlist. Leave both empty to allow any verified Google account.
# ALLOWED_EMAILS=admin@example.com,owner@example.com
# ALLOWED_DOMAINS=example.com

# Used by build-deploy.sh and docker-stack.yml.
# Change this to your registry image before production deployment.
IMAGE_NAME=admin:latest
STACK_NAME=admin
