# 결제위젯 연동 키 (RP 단건 결제용 — payment-widget-sdk)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_xxxxx
TOSS_SECRET_KEY=test_gsk_xxxxx

# API 개별 연동 키 (정기결제/빌링용 — tosspayments-sdk requestBillingAuth). 결제위젯 키는 빌링 미지원!
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=test_ck_xxxxx
TOSS_BILLING_SECRET_KEY=test_sk_xxxxx

# user-front 프로젝트 (유저/결제/해금)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 어드민 프로젝트 (document_nodes — 노드 데이터/위치/비용)
NEXT_PUBLIC_ADMIN_SUPABASE_URL=https://[ADMIN-PROJECT-ID].supabase.co
NEXT_PUBLIC_ADMIN_SUPABASE_ANON_KEY=your_admin_supabase_anon_key
ADMIN_SUPABASE_SERVICE_ROLE_KEY=your_admin_supabase_service_role_key

# 정기결제(빌링) Cron 보호용 — Vercel Cron이 Authorization: Bearer 로 전달
CRON_SECRET=your_cron_secret
